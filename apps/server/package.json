{
  "name": "@my-lovart/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=../../.env.local --import tsx ./src/server.ts",
    "start": "node --env-file=../../.env.local --import tsx ./src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:persistence": "pnpm build && node --env-file=../../.env.local ./scripts/verify-persistence.mjs",
    "verify:attachments": "pnpm build && node --env-file=../../.env.local ./scripts/verify-attachments.mjs",
    "verify:assets": "pnpm build && node --env-file=../../.env.local ./scripts/verify-assets.mjs",
    "verify:video-guard": "pnpm build && node --env-file=../../.env.local ./scripts/verify-video-guard.mjs",
    "verify:video-frame": "pnpm build && node --env-file=../../.env.local ./scripts/verify-video-frame.mjs",
    "verify:generation-config": "pnpm build && node --env-file=../../.env.local ./scripts/verify-generation-config.mjs",
    "verify:inspiration": "pnpm build && node --env-file=../../.env.local ./scripts/verify-inspiration.mjs",
    "verify:materials": "pnpm build && node --env-file=../../.env.local ./scripts/verify-materials.mjs",
    "run:video-conversation": "pnpm build && node --env-file=../../.env.local ./scripts/run-video-conversation.mjs",
    "run:inspiration-conversation": "pnpm build && node --env-file=../../.env.local ./scripts/run-inspiration-conversation.mjs",
    "run:image-to-video-probe": "pnpm build && node --env-file=../../.env.local ./scripts/run-image-to-video-probe.mjs",
    "run:video-confirmation-probe": "pnpm build && node --env-file=../../.env.local ./scripts/run-video-confirmation-probe.mjs",
    "run:batch-preproduction-probe": "pnpm build && node --env-file=../../.env.local ./scripts/run-batch-preproduction-probe.mjs",
    "trace:latest": "node ./scripts/trace-latest.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@langchain/core": "^1.1.35",
    "@langchain/langgraph": "^1.2.5",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.1",
    "@langchain/openai": "^1.3.0",
    "@my-lovart/shared": "workspace:*",
    "@supabase/supabase-js": "^2.47.10",
    "deepagents": "^1.8.4",
    "fastify": "^5.2.1",
    "pg": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "@types/node": "^22.10.7"
  }
}
